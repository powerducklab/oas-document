{
  "name": "@powerduck/oas-document",
  "version": "0.1.4",
  "description": "Production-grade OpenAPI documentation component. Pass an OAS document and get a full API documentation UI with tree navigation, auto-upgrade to OAS 3.2, and code examples.",
  "license": "MIT",
  "author": "powerduck",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./react/index.css": {
      "import": "./dist/react/index.css",
      "require": "./dist/react/index.css",
      "default": "./dist/react/index.css"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "ln -sf /Users/electron/powerduck-react/node_modules/react node_modules/react && ln -sf /Users/electron/powerduck-react/node_modules/react-dom node_modules/react-dom",
    "dev": "tsup --watch",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run check",
    "preview": "vite --config examples/vite.config.ts",
    "check:english": "node scripts/check-english.mjs",
    "benchmark": "vite-node scripts/benchmark-navigation.ts",
    "check": "npm run check:english && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@powerduck/md-editor": "^0.11.6",
    "@powerduck/openapi-codegen": "^0.6.2",
    "@powerduck/openapi-parser": "^0.3.5",
    "@powerduck/tree": "^0.7.6",
    "markmap-common": "^0.18.9",
    "react-icons": "^5.0.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^24.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "terser": "^5.51.2",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "openapi",
    "oas",
    "oas3.2",
    "api-documentation",
    "api-docs",
    "swagger",
    "react",
    "tree",
    "documentation",
    "powerduck"
  ],
  "homepage": "https://www.powerduck.com",
  "publishConfig": {
    "access": "public"
  }
}
